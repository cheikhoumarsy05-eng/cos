# Copy to .env (setup.sh does this for you) and fill in.
# Postgres connection string.
DATABASE_URI=postgres://user:password@localhost:5432/portfolio
# Payload auth secret. setup.sh generates one automatically if left blank.
PAYLOAD_SECRET=

# ── Notification des messages du formulaire de contact ──────────────────
# Sans RESEND_API_KEY, aucun e-mail n'est envoyé : Payload écrit le message
# dans la console du serveur et l'enregistrement en base continue de marcher.
# Clé à créer sur resend.com, puis à déclarer dans Vercel (Production).
RESEND_API_KEY=
# Adresse qui reçoit la notification.
CONTACT_NOTIFY_TO=cheikhoumarsy05@gmail.com
# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, laisser
# onboarding@resend.dev, la seule adresse autorisée sans vérification.
MAIL_FROM=onboarding@resend.dev

